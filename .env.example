# Copy to .env. Never commit real credentials.
# Empty bot token starts the web panel without Telegram or LLM.
TELEGRAM_BOT_TOKEN=
# Local Docker uses polling. Render's render.yaml enables webhook mode.
TELEGRAM_MODE=polling
# Webhook mode requires an HTTPS origin and a random 32-256 character secret.
# Render supplies RENDER_EXTERNAL_URL automatically instead of PUBLIC_BASE_URL.
PUBLIC_BASE_URL=
TELEGRAM_WEBHOOK_SECRET=
# Required encryption key for individual panel accounts and TOTP secrets.
# Generate once with openssl rand -hex 32. Back it up; keep across redeploys.
# Use a different value from TELEGRAM_WEBHOOK_SECRET. Never commit the real key.
PANEL_AUTH_KEY=
# Only this one Telegram user may enroll/login to the panel. Must be in allowlist.
PANEL_MASTER_USER_ID=
# Replace with positive numeric Telegram IDs, separated by commas.
TELEGRAM_ALLOWED_USER_IDS=111111111,222222222
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
# Example model with tool calling; availability/quotas depend on your Groq account.
LLM_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT=30s
APP_TIMEZONE=Europe/Moscow
# One currency per database: TMT, RUB, USD, EUR or AZN. No automatic conversion.
APP_CURRENCY=TMT
APP_PORT=8080
# Compose derives PUBLIC_BASE_URL from APP_PORT unless explicitly overridden.
HTTP_REQUEST_TIMEOUT=5s
# Set your own password before the first database startup.
# For an existing volume, use its current password; changing this does not rotate it.
POSTGRES_PASSWORD=
# 0 lets Docker select a free host port for each isolated test project.
TEST_DB_PORT=0
# Only needed for running Go outside Compose; Compose sets its internal DSN.
# Match the password to your database; URL-encode special characters in this DSN.
# For Neon/Render use sslmode=verify-full and keep channel_binding=require.
DATABASE_URL=postgres://expenses:CHANGE_ME@localhost:5432/expenses?sslmode=disable
