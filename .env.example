# Copy to .env. Never commit real credentials.
# Empty bot token starts the web panel without Telegram or LLM.
TELEGRAM_BOT_TOKEN=
# Replace with positive numeric Telegram IDs, separated by commas.
TELEGRAM_ALLOWED_USER_IDS=111111111,222222222
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
# Example model with tool calling; availability/quotas depend on your Groq account.
LLM_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT=30s
APP_TIMEZONE=Europe/Moscow
APP_PORT=8080
# Only needed for running Go outside Compose; Compose sets its internal DSN.
DATABASE_URL=postgres://expenses:expenses_local@localhost:5432/expenses?sslmode=disable
